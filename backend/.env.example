# Comma-separated list of allowed frontend origins for CORS.
# Include local development + deployed frontend URLs (no trailing slash).
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.quickapply.ai

# Enable only when using cookie/session auth across origins.
# Keep false for Authorization header / bearer-token flows.
CORS_ALLOW_CREDENTIALS=false
